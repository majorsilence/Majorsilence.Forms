<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests for Majorsilence.Forms.Theming.WinForms: create real System.Windows.Forms
       controls, apply a stylesheet, assert the WinForms properties. The project under test only
       compiles on Windows (Windows Desktop targeting pack), so off Windows this is an empty stub that
       keeps the full-solution build green on the Linux/macOS CI legs. Runs in CI's "Test (Windows,
       full solution)" step. -->

  <PropertyGroup>
    <_IsWindowsBuild Condition="'$(OS)' == 'Windows_NT'">true</_IsWindowsBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit2013</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' != 'true'">
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Theming.WinForms\Majorsilence.Forms.Theming.WinForms.csproj" />
  </ItemGroup>

</Project>
