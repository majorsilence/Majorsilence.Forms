using System;
using System.Collections.Generic;
using System.Linq;

namespace Majorsilence.Forms
{
    public static partial class ToolStripManager
    {
        // Every move a Merge made, per target strip, so RevertMerge can put things back (W6 mechanisms).
        private static readonly Dictionary<ToolStrip, List<MergeRecord>> merge_history = new ();
        internal static string? DebugLastMerge;

        private sealed record MergeRecord (
            ToolStrip Source,
            ToolStripItemCollection SourceItems, MenuItem? Moved, int SourceIndex,
            ToolStripItemCollection TargetItems, MenuItem? Displaced, int TargetIndex);

        /// <summary>Merges the items of one strip into another, as each item's <see cref="ToolStripItem.MergeAction"/> says.</summary>
        /// <remarks>
        /// Real as of W6 mechanisms. Both strips must <see cref="ToolStrip.AllowMerge"/>. Items match on
        /// <see cref="MenuItem.Text"/>, as upstream matches them: <see cref="MergeAction.Append"/> and
        /// <see cref="MergeAction.Insert"/> (at <see cref="ToolStripItem.MergeIndex"/>) move the item over;
        /// <see cref="MergeAction.Replace"/> puts it in a matching item's place; <see cref="MergeAction.Remove"/>
        /// takes the matching item out; <see cref="MergeAction.MatchOnly"/> merges the item's drop-down into
        /// the matching item's drop-down. <see cref="RevertMerge(ToolStrip)"/> undoes it all.
        /// </remarks>
        public static bool Merge (ToolStrip sourceToolStrip, ToolStrip targetToolStrip)
        {
            Guard.ThrowIfNull (sourceToolStrip);
            Guard.ThrowIfNull (targetToolStrip);

            if (ReferenceEquals (sourceToolStrip, targetToolStrip) || !sourceToolStrip.AllowMerge || !targetToolStrip.AllowMerge)
                return false;

            var records = new List<MergeRecord> ();

            MergeInto (sourceToolStrip, sourceToolStrip.Items, targetToolStrip.Items, records);
            DebugLastMerge = $"srcCount={sourceToolStrip.Items.Count} records={records.Count} tgtCount={targetToolStrip.Items.Count}";

            if (records.Count == 0)
                return false;

            if (!merge_history.TryGetValue (targetToolStrip, out var history))
                merge_history[targetToolStrip] = history = new List<MergeRecord> ();

            history.AddRange (records);
            Relayout (sourceToolStrip);
            Relayout (targetToolStrip);

            return true;
        }

        /// <inheritdoc cref="Merge(ToolStrip, ToolStrip)"/>
        public static bool Merge (ToolStrip sourceToolStrip, string targetName)
            => FindToolStrip (targetName) is { } target && Merge (sourceToolStrip, target);

        private static void MergeInto (ToolStrip source, ToolStripItemCollection sourceItems, ToolStripItemCollection targetItems, List<MergeRecord> records)
        {
            foreach (var item in sourceItems.ToList ()) {
                var action = (item as ToolStripItem)?.MergeAction ?? MergeAction.Append;
                var merge_index = (item as ToolStripItem)?.MergeIndex ?? -1;
                var match = string.IsNullOrEmpty (item.Text) ? null
                    : targetItems.FirstOrDefault (t => string.Equals (t.Text, item.Text, StringComparison.Ordinal));

                switch (action) {
                case MergeAction.Remove:
                    if (match is not null) {
                        var at = targetItems.IndexOf (match);
                        targetItems.Remove (match);
                        records.Add (new MergeRecord (source, sourceItems, null, -1, targetItems, match, at));
                    }

                    break;

                case MergeAction.MatchOnly:
                    if (match is ToolStripDropDownItem target_drop && item is ToolStripDropDownItem source_drop)
                        MergeInto (source, source_drop.DropDownItems, target_drop.DropDownItems, records);

                    break;

                case MergeAction.Replace when match is not null: {
                    var at = targetItems.IndexOf (match);
                    var from = sourceItems.IndexOf (item);

                    targetItems.Remove (match);
                    sourceItems.Remove (item);
                    targetItems.Insert (Math.Min (at, targetItems.Count), item);
                    records.Add (new MergeRecord (source, sourceItems, item, from, targetItems, match, at));
                    break;
                }

                case MergeAction.Insert: {
                    var from = sourceItems.IndexOf (item);
                    sourceItems.Remove (item);

                    var at = merge_index < 0 ? targetItems.Count : Math.Min (merge_index, targetItems.Count);
                    targetItems.Insert (at, item);
                    records.Add (new MergeRecord (source, sourceItems, item, from, targetItems, null, at));
                    break;
                }

                default: {
                    // Append, and Replace with nothing to replace.
                    var from = sourceItems.IndexOf (item);
                    sourceItems.Remove (item);
                    targetItems.Add (item);
                    records.Add (new MergeRecord (source, sourceItems, item, from, targetItems, null, targetItems.Count - 1));
                    break;
                }
                }
            }
        }

        /// <summary>Undoes every merge into the target, most recent first.</summary>
        public static bool RevertMerge (ToolStrip targetToolStrip) => RevertMergeCore (targetToolStrip, null);

        /// <inheritdoc cref="RevertMerge(ToolStrip)"/>
        public static bool RevertMerge (string targetName)
            => FindToolStrip (targetName) is { } target && RevertMergeCore (target, null);

        /// <summary>Undoes the merges from one source into the target, most recent first.</summary>
        public static bool RevertMerge (ToolStrip targetToolStrip, ToolStrip sourceToolStrip) => RevertMergeCore (targetToolStrip, sourceToolStrip);

        private static bool RevertMergeCore (ToolStrip target, ToolStrip? source)
        {
            Guard.ThrowIfNull (target);

            if (!merge_history.TryGetValue (target, out var history))
                return false;

            var reverting = history.Where (r => source is null || ReferenceEquals (r.Source, source)).ToList ();

            if (reverting.Count == 0)
                return false;

            for (var i = reverting.Count - 1; i >= 0; i--) {
                var record = reverting[i];

                if (record.Moved is { } moved) {
                    record.TargetItems.Remove (moved);
                    record.SourceItems.Insert (Math.Min (Math.Max (0, record.SourceIndex), record.SourceItems.Count), moved);
                }

                if (record.Displaced is { } displaced)
                    record.TargetItems.Insert (Math.Min (record.TargetIndex, record.TargetItems.Count), displaced);

                history.Remove (record);
                Relayout (record.Source);
            }

            if (history.Count == 0)
                merge_history.Remove (target);

            Relayout (target);

            return true;
        }

        private static void Relayout (ToolStrip strip)
        {
            strip.PerformLayout ();
            strip.Invalidate ();
        }
    }
}
