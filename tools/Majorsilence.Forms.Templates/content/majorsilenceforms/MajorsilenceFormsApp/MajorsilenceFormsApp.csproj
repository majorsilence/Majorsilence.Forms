<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop head: Windows, macOS and Linux, on the Avalonia backend. This is the project
       `dotnet run` starts. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms.Avalonia" Version="MSFORMS_PACKAGE_VERSION" />
    <ProjectReference Include="..\MajorsilenceFormsApp.Shared\MajorsilenceFormsApp.Shared.csproj" />
  </ItemGroup>

</Project>
