<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android head. Needs the `android` workload: `dotnet workload install android`. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.majorsilence.majorsilenceformsapp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms.Avalonia" Version="MSFORMS_PACKAGE_VERSION" />
    <PackageReference Include="Avalonia.Android" Version="MSFORMS_AVALONIA_VERSION" />
    <ProjectReference Include="..\MajorsilenceFormsApp.Shared\MajorsilenceFormsApp.Shared.csproj" />
  </ItemGroup>

</Project>
