<Project>

  <!-- Shared by the Majorsilence.Forms.WinFormsShims.Compat* projects. Each sets CompatSyncProject (the
       key in compat-rules.json) and imports this; nothing here is hand-written code. The project's
       `generated` folder is produced by tools/CompatSync/CompatSync.cs from the real Majorsilence.Forms
       sources and is git-ignored.

       Incremental: Inputs/Outputs against the tool's .stamp, so an unchanged tree skips the (slow to
       start) `dotnet run`. The outer multi-targeting build generates once, before the inner builds fan
       out, so they never race; an inner build run on its own generates for itself.

       The Compile items are added inside the target, not by a glob, because on a clean checkout the
       folder does not exist yet when the project is evaluated. -->

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CompatSyncTool>$(MSBuildThisFileDirectory)CompatSync.cs</CompatSyncTool>
    <CompatSyncRules>$(MSBuildThisFileDirectory)compat-rules.json</CompatSyncRules>
    <CompatGeneratedDir>$(MSBuildProjectDirectory)/generated/</CompatGeneratedDir>
    <CompatSourceRoot>$(MSBuildThisFileDirectory)../../src/</CompatSourceRoot>
    <CompatRepoRoot>$([System.IO.Path]::GetFullPath ('$(MSBuildThisFileDirectory)../..'))</CompatRepoRoot>

    <!-- Copies of the real sources: the original's analyzer rules, doc warnings and nullable annotations
         were already satisfied there, and a generated file is not the place to fix them. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0436;CS8618;CS8625;CS8600;CS8601;CS8602;CS8603;CS8604;CS8765;CS8767;CS0108;CA1416;CS0618;CS0612</NoWarn>
    <AnalysisLevel>none</AnalysisLevel>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- The tool reads all three source projects to resolve names across them, so any of them changing
       invalidates every generated folder. -->
  <ItemGroup>
    <CompatSyncInput Include="$(CompatSourceRoot)Majorsilence.Forms/**/*.cs;$(CompatSourceRoot)Majorsilence.Forms.Drawing.Common/**/*.cs;$(CompatSourceRoot)Majorsilence.Forms.Avalonia/**/*.cs"
                     Exclude="$(CompatSourceRoot)*/obj/**;$(CompatSourceRoot)*/bin/**" />
    <CompatSyncInput Include="$(CompatSourceRoot)Majorsilence.Forms/ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- Runs the tool under an exclusive file lock held for the whole process. A task rather than an Exec so
       the lock works the same on Windows, Linux and macOS with nothing but the SDK. -->
  <UsingTask TaskName="CompatSyncRunExclusive" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DotNet ParameterType="System.String" />
      <Arguments ParameterType="System.String" Required="true" />
      <WorkingDirectory ParameterType="System.String" Required="true" />
      <LockFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Threading" />
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Diagnostics;
using System.IO;
using System.Threading;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class CompatSyncRunExclusive : Task
{
    public string DotNet { get; set; }
    public string Arguments { get; set; }
    public string WorkingDirectory { get; set; }
    public string LockFile { get; set; }

    public override bool Execute ()
    {
        FileStream gate = null;
        var give_up = DateTime.UtcNow.AddMinutes (20);
        while (gate == null) {
            try {
                gate = new FileStream (LockFile, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
            } catch (IOException) when (DateTime.UtcNow < give_up) {
                Thread.Sleep (250);
            }
        }

        using (gate) {
            var info = new ProcessStartInfo (string.IsNullOrEmpty (DotNet) ? "dotnet" : DotNet, Arguments) {
                WorkingDirectory = WorkingDirectory,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
            };
            using (var process = Process.Start (info)) {
                process.OutputDataReceived += (_, e) => { if (e.Data != null) Log.LogMessage (MessageImportance.High, e.Data); };
                process.ErrorDataReceived += (_, e) => { if (e.Data != null) Log.LogMessage (MessageImportance.High, e.Data); };
                process.BeginOutputReadLine ();
                process.BeginErrorReadLine ();
                process.WaitForExit ();
                if (process.ExitCode != 0)
                    Log.LogError ("CompatSync exited with code {0}; its output is above.", process.ExitCode);
                return process.ExitCode == 0;
            }
        }
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CompatSyncGenerate"
          BeforeTargets="CoreCompile;DispatchToInnerBuilds;GenerateAssemblyInfo"
          Inputs="@(CompatSyncInput);$(CompatSyncRules);$(CompatSyncTool)"
          Outputs="$(CompatGeneratedDir).stamp">
    <!-- `dotnet run file.cs` compiles into a cache directory keyed by the file, and two runs at once collide on
         it (CS2012 / "build-success.cache is being used by another process"). More than one can start at
         once: the solution builds the three Compat projects in parallel, and a ProjectReference to a
         multi-targeted project builds its net8.0 and net10.0 inner builds in parallel without going through
         the outer build that generates first. So every run takes one machine-wide lock; a run that waits
         finds the stamp current and the tool returns at once. -->
    <CompatSyncRunExclusive DotNet="$(DOTNET_HOST_PATH)"
                            Arguments="run &quot;$(CompatSyncTool)&quot; -- --project $(CompatSyncProject) --repo &quot;$(CompatRepoRoot)&quot;"
                            WorkingDirectory="$(MSBuildThisFileDirectory)"
                            LockFile="$([System.IO.Path]::GetTempPath())compatsync-run-$([MSBuild]::StableStringHash('$(CompatRepoRoot)')).lock" />
  </Target>

  <Target Name="CompatSyncCompileItems"
          BeforeTargets="CoreCompile;GenerateAssemblyInfo"
          DependsOnTargets="CompatSyncGenerate"
          Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <Compile Include="$(CompatGeneratedDir)**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
