<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Uno's analyzers/skia profile; keep warnings non-fatal here. -->
    <NoWarn>$(NoWarn);CA1416;Uno0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.Uno</PackageId>
    <Description>Uno Platform (Skia) platform backend for Majorsilence.Forms — hosts a cross-platform WinForms app on Uno's desktop, iOS, Android and WebAssembly targets.</Description>
    <PackageTags>majorsilence-forms;winforms;cross-platform;uno-platform;uno;winui;skiasharp;backend;wasm;mobile</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="SkiaSharp.Views.Uno.WinUI" />
  </ItemGroup>

</Project>
