<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The GirCore.* packages are not available on the corporate feeds (they 403, same as the Uno
    packages). Scope this project's restore to nuget.org only so it resolves GirCore.Gtk-4.0 and its
    transitive Gdk/Gsk/Pango/Cairo/Gio/GObject/GLib packages cleanly without the corporate feeds'
    403 aborting the restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
