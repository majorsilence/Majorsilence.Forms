<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF (System.Windows) platform backend: hosts Majorsilence.Forms on a real WPF Window
       (Skia surface presented through a WriteableBitmap), plus the embedding direction — a
       MajorsilenceFormsPresenter element and ToWpfElement()/ToWpfWindow(), the same pair
       Majorsilence.Forms.Avalonia / .Uno / .WinForms provide for their hosts.

       Targets:
         * net48                — classic .NET Framework 4.8 WPF apps. Consumes the netstandard2.0
                                  row of Majorsilence.Forms. Builds on any OS via the reference-assembly
                                  package (the WPF reference assemblies ship in it too; only *running*
                                  WPF needs Windows), so it is a real compile gate on every CI leg.
         * net8.0-windows /
           net10.0-windows      — modern .NET WPF. EnableWindowsTargeting lets net*-windows + UseWPF
                                  *compile* on the Linux/macOS CI legs against the reference assemblies
                                  (it just can't run there), so those are a real compile gate everywhere
                                  too. The shipped package is produced by the Windows CI leg (see
                                  release.yml's pack-windows job).

       Windows-only at runtime by definition — WPF only runs on Windows. -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The SDK otherwise defaults net48 / net*-windows to C# 7.3, which rejects the repo-wide
         Nullable=enable and the switch expressions / patterns this project uses; force latest. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- .NET Framework 4.8 reference assemblies so net48 builds on any runner (this package carries
         the WPF reference assemblies — PresentationCore/PresentationFramework/WindowsBase/System.Xaml —
         so UseWPF resolves against them; the Windows CI leg also has the real targeting pack). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <!-- Microsoft.Win32.OpenFolderDialog is WPF .NET 8+; the net48 folder picker in WpfDialogs falls
         back to the in-box System.Windows.Forms.FolderBrowserDialog (framework assembly, no package). -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.Wpf</PackageId>
    <Description>WPF (System.Windows) platform backend for Majorsilence.Forms — run a cross-platform WinForms-style app on a real WPF Window, or embed Majorsilence.Forms controls in an existing WPF application via MajorsilenceFormsPresenter/ToWpfElement(), then switch to the Avalonia or Uno host once ported. Windows-only, like WPF itself.</Description>
    <PackageTags>wpf;system-windows;presentation-foundation;interop;migration;majorsilence-forms;windows;skiasharp;backend;dotnet-framework</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

  <!-- SkiaSharp comes transitively from Majorsilence.Forms; no SkiaSharp.Views.WPF (its SKElement /
       WriteableBitmap present path is done directly here, mirroring the WinForms backend's
       SkiaHostControl, to avoid that package's SkiaSharp.Views.Desktop shim collisions). -->

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Majorsilence.Forms.Tests" />
  </ItemGroup>

</Project>
