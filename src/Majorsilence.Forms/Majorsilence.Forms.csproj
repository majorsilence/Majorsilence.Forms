<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Trimming/NativeAOT concepts don't apply to the netstandard2.0 consumers (.NET Framework 4.7.2+,
         Mono, older Unity). On the .NET TFMs IsAotCompatible turns on the trim + AOT + single-file
         analyzers (and implies IsTrimmable) so a new reflection/dynamic-code hazard fails the Release
         build (TreatWarningsAsErrors) rather than silently breaking a trimmed or NativeAOT consumer.
         See docs/backends.md "Trimming and NativeAOT". -->
    <IsTrimmable Condition=" '$(TargetFramework)' != 'netstandard2.0' ">true</IsTrimmable>
    <IsAotCompatible Condition=" '$(TargetFramework)' != 'netstandard2.0' ">true</IsAotCompatible>
    <!-- The SDK otherwise defaults the netstandard2.0 row to C# 7.3, which breaks the nullable
         annotations, records, switch expressions, file-scoped namespaces, collection expressions,
         etc. used throughout this project. Same reason Majorsilence.Forms.Drawing.Common sets it. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <!-- Span<T>/ReadOnlySpan<T> are in-box on the .NET TFMs; a package for netstandard2.0. SkiaSharp's
         own netstandard2.0 row depends on it too. -->
    <PackageReference Include="System.Memory" />
    <!-- Source-generates the compiler-required types/attributes missing from the netstandard2.0 BCL
         (Index/Range, IsExternalInit for records/init, HashCode, CallerArgumentExpression, the
         nullable-flow and trimming attributes). PrivateAssets=all: never a real dependency. -->
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <!-- JsonSerializer.Serialize + ValueTask + System.Reflection.Metadata.TypeName, in-box on the .NET
         TFMs (see Directory.Packages.props). -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
    <PackageReference Include="System.Reflection.Metadata" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <!-- Interaction.cs is a Microsoft.VisualBasic (MsgBox/InputBox) migration convenience. Microsoft
         .VisualBasic.Core is in-box on net8.0/net10.0; on netstandard2.0 / .NET Framework it would need
         the Microsoft.VisualBasic package, whose assembly-identity clash with the .NET Framework GAC
         copy is a known headache. VbInteraction has no other callers in the assembly, so it is simply
         excluded from the netstandard2.0 surface (documented as a known gap). -->
    <Compile Remove="Interaction.cs" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <!-- The trimming attributes (RequiresUnreferencedCode, UnconditionalSuppressMessage, ...) used in
         this project's source are otherwise outside PolySharp's default polyfill set. -->
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
    <!-- netstandard2.0's reference assembly predates the nullable-flow annotations on the BCL, most
         importantly NotNullWhen(false) on string.IsNullOrEmpty / IsNullOrWhiteSpace and
         DoesNotReturnIf on Debug.Assert. Every hit is inside an existing IsNullOrEmpty / pattern
         guard and compiles clean on net8.0/net10.0, where the annotations exist; these are the
         same source files, nullable-checked for real on those TFMs. Suppressed only for the
         netstandard2.0 row so its Release build (TreatWarningsAsErrors) is not blocked by the gap. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8767</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms</PackageId>
    <Description>Cross-platform WinForms for .NET. A Windows Forms compatibility layer that runs your existing WinForms apps on Windows, macOS, Linux, mobile and the browser — the same Form, controls, event handlers and *.Designer.cs files, with no rewrite. Requires a backend package (Majorsilence.Forms.Avalonia for desktop).</Description>
    <PackageTags>winforms;windows-forms;system-windows-forms;cross-platform;winforms-compatibility;winforms-alternative;migration;gui;ui;desktop;linux;macos;skiasharp;avalonia;uno;dotnet</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <!-- Pin HarfBuzz to the SkiaSharp 3.x-aligned versions (overrides RichTextKit's 2.88 transitive). -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Topten.RichTextKit" />
    <PackageReference Include="System.Formats.Nrbf" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- All GDI+/SkiaSharp drawing primitives (Brush, Pen, Font, Image, Icon, Region, StringFormat,
         Drawing2D, Imaging, ...) live in this separate, separately-packaged assembly. The few drawing
         types still under src/Majorsilence.Forms/Drawing/ stay because they reach back into the Forms
         layer (Control / Theme / TextMeasurer / ImageListStreamer) and cannot move without creating a
         circular project reference; see the header comment on each of those files. -->
    <ProjectReference Include="..\Majorsilence.Forms.Drawing.Common\Majorsilence.Forms.Drawing.Common.csproj" />
  </ItemGroup>

  <!-- Majorsilence.Forms.WinFormsEnumShims' compiled output gets embedded as a resource (below), not
       referenced normally: a plain <ProjectReference> ships it as its own separate deps.json/runtime
       entry, keyed by *project* name; but the whole point of that assembly is being loadable at
       runtime under its own distinct AssemblyName ("System.Windows.Forms", deliberately; see that
       project's own comments and RegisterWinFormsEnumResolver below), and deps.json generation for
       ProjectReferences doesn't respect that override, so a normal reference makes the file recorded
       in deps.json fall out of sync with the actual assembly identity (hit this directly: worked at
       the individual-project level, then failed with FileNotFoundException as soon as a consuming
       app's own deps.json-driven host tried to load it). Embedding the bytes and loading them via
       Assembly.Load(byte[]) at runtime (see RegisterWinFormsEnumResolver) sidesteps deps.json
       entirely; there is nothing there to fall out of sync with. -->
  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms.WinFormsEnumShims\Majorsilence.Forms.WinFormsEnumShims.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Majorsilence.Forms.DrawingShims\Majorsilence.Forms.DrawingShims.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="EmbedWinFormsEnumShims" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\Majorsilence.Forms.WinFormsEnumShims\Majorsilence.Forms.WinFormsEnumShims.csproj"
             Targets="Build"
             Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WinFormsEnumShimsBuildOutput" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_WinFormsEnumShimsBuildOutput)" Condition="'%(Extension)' == '.dll'">
        <LogicalName>Majorsilence.Forms.WinFormsEnumShims.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- Same shape as EmbedWinFormsEnumShims above, and embedded for the same deps.json reason. -->
  <Target Name="EmbedDrawingShims" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\Majorsilence.Forms.DrawingShims\Majorsilence.Forms.DrawingShims.csproj"
             Targets="Build"
             Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DrawingShimsBuildOutput" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_DrawingShimsBuildOutput)" Condition="'%(Extension)' == '.dll'">
        <LogicalName>Majorsilence.Forms.DrawingShims.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Backend assemblies live separately and reach into the core's internal window/render/input
         plumbing (RenderFrame, Handle*, OnBackend*, the Backend field) through the IWindowBackend seam. -->
    <InternalsVisibleTo Include="Majorsilence.Forms.Avalonia" />
    <InternalsVisibleTo Include="Majorsilence.Forms.Headless" />
    <InternalsVisibleTo Include="Majorsilence.Forms.Uno" />
    <InternalsVisibleTo Include="Majorsilence.Forms.WinForms" />
    <InternalsVisibleTo Include="Majorsilence.Forms.Wpf" />
    <InternalsVisibleTo Include="Majorsilence.Forms.Tests" />
    <InternalsVisibleTo Include="Majorsilence.Forms.Telerik" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pre-expanded, deflate-compressed Hunspell/SCOWL en_US wordlist backing Majorsilence.Forms.SpellCheck.
         See third-party-licenses.md (SCOWL / Kuenning Ispell section) for licensing. -->
    <EmbeddedResource Include="SpellCheck/en_US.words.gz" />
  </ItemGroup>

</Project>
