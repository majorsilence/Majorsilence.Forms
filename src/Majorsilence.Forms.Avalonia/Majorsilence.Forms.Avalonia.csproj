<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-browser is an extra row (not a replacement for net10.0): it is the WebAssembly-in-browser
         flavor of the backend, selected automatically when a browser-wasm head project (samples/Gallery.Wasm)
         references this project. Desktop consumers keep resolving net8.0/net10.0 as before. -->
    <TargetFrameworks>net8.0;net10.0;net10.0-browser</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.Avalonia</PackageId>
    <Description>Avalonia 12 platform backend for Majorsilence.Forms.</Description>
    <PackageTags>Majorsilence;Forms;Avalonia;Backend;Cross;Platform</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <!-- Desktop (Windows/macOS/Linux): native windowing + the real native-engine webview control. Neither
       builds for browser-wasm (no OS window manager, no WebView2/WKWebView/WebKitGTK in a browser tab). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-browser'">
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <!-- Browser (WebAssembly): Avalonia's browser platform replaces Avalonia.Desktop; there is no
       WebView-equivalent package, so AvaloniaWebViewHandle.cs (which needs Avalonia.Controls.WebView)
       is excluded below and AvaloniaPlatformBackend's WebView members report unsupported instead. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <PackageReference Include="Avalonia.Browser" />
    <Compile Remove="AvaloniaWebViewHandle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
