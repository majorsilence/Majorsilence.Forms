<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-browser is an extra row (not a replacement for net10.0): it is the WebAssembly-in-browser
         flavor of the backend, selected automatically when a browser-wasm head project (samples/Gallery.Wasm)
         references this project. Desktop consumers keep resolving net8.0/net10.0 as before. -->
    <TargetFrameworks>net8.0;net10.0;net10.0-browser</TargetFrameworks>
    <!-- net10.0-android is likewise an extra row, but opt-in rather than unconditional like the browser
         row above: unlike wasm-tools (only needed for `dotnet publish`), the `android` workload's
         reference assemblies (Activity/Bundle/etc.) are required just to *compile* against net10.0-android,
         so unconditionally listing it would break `dotnet build` for every contributor and CI leg that
         hasn't installed that workload. EnableAndroidHead (repo-root Directory.Build.props) is what
         resolves that: the EnableMobileHeads umbrella narrowed to hosts that actually have the android
         workload, plus the ungated EnableAndroidTarget=true force release.yml packs with. It switches
         on samples/Gallery.Android at the same time.

         Deliberately NOT EnableMobileHeads: android and ios take different workloads, so keying both
         rows on the umbrella made -p:EnableMobileHeads=true on an ios-only macOS host (CI's ios job)
         demand the android workload and fail with NETSDK1147. -->
    <TargetFrameworks Condition="'$(EnableAndroidHead)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <!-- net10.0-ios is opt-in for the same reason net10.0-android is: the ios workload's reference
         assemblies are required just to *compile*. Unlike the android workload, the ios workload is
         only installable on macOS (there is no Linux/Windows path at all, since Apple's toolchain is a
         hard requirement), so EnableIOSHead gates on the host OS being macOS too; it also switches on
         samples/Gallery.iOS, and EnableIOSTarget=true forces it directly. See Directory.Build.props. -->
    <TargetFrameworks Condition="'$(EnableIOSHead)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Trim + AOT + single-file analyzers. This backend renders the Majorsilence scene into a Skia
         framebuffer over a XAML-less Avalonia.Application, so it stays clear of Avalonia's own
         reflection-heavy XAML paths and analyzes clean. See docs/backends.md "Trimming and NativeAOT". -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Every project file here lives in "namespace Majorsilence.Forms { }" and refers to the Avalonia
         package's types unqualified (bare "Avalonia.Whatever"). The default RootNamespace (derived from
         the assembly/project name) is "Majorsilence.Forms.Avalonia", which is fine normally, but the Android SDK
         auto-generates a Resource designer class as "namespace Majorsilence.Forms.Avalonia { class
         Resource ... }" for the net10.0-android row, which makes that a *real* sibling namespace. C#'s
         enclosing-namespace lookup then finds it ahead of the "using Avalonia;" import for any bare
         "Avalonia.X" reference inside "namespace Majorsilence.Forms { }", shadowing the actual package and
         breaking the build with "'X' does not exist in the namespace 'Majorsilence.Forms.Avalonia'"
         errors. Overriding RootNamespace to something that doesn't end in ".Avalonia" avoids the collision
         entirely (harmless elsewhere, since every file here already declares its own explicit namespace). -->
    <RootNamespace>Majorsilence.Forms.AvaloniaBackend</RootNamespace>
  </PropertyGroup>

  <!-- All three single-view platforms (no real OS window manager: one embeddable view per app/tab/
       screen, not per-Form) share this property so the many conditions below don't have to keep
       repeating a three-way TargetFramework comparison, and so a fourth single-view platform later
       only needs to change this one spot. -->
  <PropertyGroup>
    <IsSingleView Condition="'$(TargetFramework)' == 'net10.0-browser' OR '$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'">true</IsSingleView>
  </PropertyGroup>

  <!-- MajorsilenceFormsSingleViewHost and the relevant AvaloniaPlatformBackend members compile in for
       any single-view platform without duplicating BROWSER-only code paths under a second, parallel
       ANDROID/IOS branch. -->
  <PropertyGroup Condition="'$(IsSingleView)' == 'true'">
    <DefineConstants>$(DefineConstants);SINGLEVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.Avalonia</PackageId>
    <Description>Avalonia 12 platform backend for Majorsilence.Forms — the default desktop host, so a cross-platform WinForms app gets real native windows on Windows, macOS and Linux, plus Android, iOS and Browser (WebAssembly) through Avalonia's own targets.</Description>
    <PackageTags>majorsilence-forms;winforms;cross-platform;avalonia;backend;desktop;linux;macos;wasm;skiasharp</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <!-- Desktop (Windows/macOS/Linux): native windowing + the real native-engine webview control. The
       single-view platforms don't build this: none has an OS window manager, browser/WASM has no
       native webview at all, and while Android and iOS do have one, Avalonia.Controls.WebView is not
       wired up for those rows here yet (see the Compile Remove below). -->
  <ItemGroup Condition="'$(IsSingleView)' != 'true'">
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <!-- Browser (WebAssembly): Avalonia's browser platform replaces Avalonia.Desktop. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <!-- Android: Avalonia's Android platform replaces Avalonia.Desktop. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <!-- iOS: Avalonia's iOS platform replaces Avalonia.Desktop. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!-- No single-view platform has a WebView-equivalent package wired up here, so
       AvaloniaWebViewHandle.cs (which needs Avalonia.Controls.WebView) is excluded and
       AvaloniaPlatformBackend's WebView members report unsupported instead. -->
  <ItemGroup Condition="'$(IsSingleView)' == 'true'">
    <Compile Remove="AvaloniaWebViewHandle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the wheel-delta conversion can be tested directly; it is the kind of unit arithmetic that
         is easy to get subtly wrong and expensive to notice by hand. -->
    <InternalsVisibleTo Include="Majorsilence.Forms.Tests" />
  </ItemGroup>

</Project>
