<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated copy of Majorsilence.Forms with its namespaces rewritten to System.Windows.Forms (and the
       GDI+-shaped parts to System.Drawing.*), so C# and Visual Basic source written against real WinForms
       compiles unchanged, Designer files included. Contains no hand-written code: everything under
       generated/ is produced at build time by tools/CompatSync from the real project, which is never
       modified. This replaces the earlier Roslyn source generator, which emitted subclasses and wrappers,
       could not make Control a wrapper, and cannot serve Visual Basic.

       Use it INSTEAD OF Majorsilence.Forms, not alongside: both define Form and Button, in different
       namespaces and assemblies. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <CompatSyncProject>core</CompatSyncProject>
    <!-- The original's embedded-resource names derive from this, and its code looks them up by name. -->
    <RootNamespace>Majorsilence.Forms</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.WinFormsShims.Compat</PackageId>
    <Description>Cross-platform System.Windows.Forms: Majorsilence.Forms generated with the real WinForms namespaces and type names, so existing C# and Visual Basic WinForms source and Designer files compile unchanged on Windows, macOS and Linux. Requires a backend (Majorsilence.Forms.WinFormsShims.Compat.Avalonia).</Description>
    <PackageTags>Majorsilence;Forms;Winforms;System.Windows.Forms;Compat;Migration;VisualBasic;vb;cross-platform</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms.WinFormsShims.Compat.Drawing\Majorsilence.Forms.WinFormsShims.Compat.Drawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Topten.RichTextKit" />
    <PackageReference Include="System.Formats.Nrbf" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Majorsilence.Forms\SpellCheck\en_US.words.gz" LogicalName="Majorsilence.Forms.SpellCheck.en_US.words.gz" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' != 'netstandard2.0' ">
    <!-- Generated alongside the sources, with its assembly and type names rewritten. -->
    <EmbeddedResource Include="generated\ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" Condition="Exists('generated\ILLink.Descriptors.xml')" />
  </ItemGroup>

  <!-- The resx-compatibility stand-in assemblies, embedded rather than referenced for the reason given in
       Majorsilence.Forms.csproj (their assembly names deliberately differ from their project names). The
       code that loads them is copied verbatim and looks them up by these resource names. -->
  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Forms.WinFormsEnumShims\Majorsilence.Forms.WinFormsEnumShims.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Majorsilence.Forms.DrawingShims\Majorsilence.Forms.DrawingShims.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="EmbedWinFormsEnumShims" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\Majorsilence.Forms.WinFormsEnumShims\Majorsilence.Forms.WinFormsEnumShims.csproj"
             Targets="Build"
             Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WinFormsEnumShimsBuildOutput" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_WinFormsEnumShimsBuildOutput)" Condition="'%(Extension)' == '.dll'">
        <LogicalName>Majorsilence.Forms.WinFormsEnumShims.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="EmbedDrawingShims" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\Majorsilence.Forms.DrawingShims\Majorsilence.Forms.DrawingShims.csproj"
             Targets="Build"
             Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DrawingShimsBuildOutput" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_DrawingShimsBuildOutput)" Condition="'%(Extension)' == '.dll'">
        <LogicalName>Majorsilence.Forms.DrawingShims.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Import Project="..\..\tools\CompatSync\CompatSync.targets" />

</Project>
