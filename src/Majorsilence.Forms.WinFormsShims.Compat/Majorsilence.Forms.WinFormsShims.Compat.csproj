<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proof-of-concept Roslyn source generator: emits thin subclasses of Majorsilence.Forms'
       Control/Component hierarchy into the real "System.Windows.Forms" namespace, so a consumer
       (typically a distributed control library that cannot rewrite its own public API namespace)
       can reference this package instead of System.Windows.Forms and keep unmodified `using
       System.Windows.Forms;` source, including WinForms Designer.cs files.

       Scope is deliberately narrow for this PoC: Component/Control/WindowBase-derived public,
       non-sealed types only. Majorsilence.Forms.Drawing's sealed leaf types (Font, Pen, Brush, ...)
       and events typed to Majorsilence-specific EventArgs are out of scope; see the feasibility
       writeup this project exists to validate. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- An analyzer package carries no lib/ref assets: everything ships under analyzers/dotnet/cs, so
         the dependency group's netstandard2.0 has no matching lib folder. NU5128 says so, and Release
         turns warnings into errors, which is why `dotnet pack` on this project failed outright: no
         amount of adding it to a publish list would have shipped it. Same suppression, for the same
         reason, as Majorsilence.Forms.Migrator's. -->
    <NoWarn>$(NoWarn);RS1036;NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.WinFormsShims.Compat</PackageId>
    <Description>PoC: source-generates a System.Windows.Forms-namespace compatibility surface backed by Majorsilence.Forms, for control libraries that cannot rewrite their own public API namespace.</Description>
    <PackageTags>Majorsilence;Forms;Winforms;Migration;SourceGenerator;Compat</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Deliberately NOT DevelopmentDependency. That flag makes the consuming PackageReference
         private, which suppresses everything flowing out of this package, including its dependency on
         Majorsilence.Forms, the assembly the generated types derive from. A consumer of this generator
         puts those generated types in its OWN public API, so the runtime reference has to flow to its
         consumers as well. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reason this is here is packaging, not compilation: the generator emits source that
         subclasses Majorsilence.Forms' Control/Component types, so a consumer installing only the
         analyzer gets a few thousand compile errors. `dotnet pack` turns this ProjectReference into a
         nuspec dependency on the Majorsilence.Forms package at the same version, which is what makes
         installing this one sufficient. The generator's own code does not use the assembly. -->
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the generator under analyzers/dotnet/cs so consumers pick it up automatically, per the
         standard analyzer-package convention. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
