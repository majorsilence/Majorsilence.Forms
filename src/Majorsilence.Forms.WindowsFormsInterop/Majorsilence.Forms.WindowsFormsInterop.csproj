<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only bridge: lets a Majorsilence.Forms app host legacy System.Windows.Forms forms during an
       incremental migration. System.Windows.Forms only exists on Windows, so off Windows this project compiles
       to an empty placeholder assembly — that keeps the full-solution `dotnet build` green on the Linux/macOS
       CI legs (which run Release with TreatWarningsAsErrors). -->

  <PropertyGroup>
    <_IsWindowsBuild Condition="'$(OS)' == 'Windows_NT'">true</_IsWindowsBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <PackageId>Majorsilence.Forms.WindowsFormsInterop</PackageId>
    <Description>Windows-only bridge to host legacy System.Windows.Forms forms from a Majorsilence.Forms app, and the reverse — so a WinForms application can be migrated cross-platform one screen at a time instead of all at once.</Description>
    <PackageTags>winforms;windows-forms;interop;migration;incremental-migration;majorsilence-forms;windows</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Only the Windows leg packs, so the README item is scoped the same way. -->
  <ItemGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' != 'true'">
    <!-- Nothing to compile off Windows. -->
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <ProjectReference Include="..\Majorsilence.Forms\Majorsilence.Forms.csproj" />
  </ItemGroup>

</Project>
