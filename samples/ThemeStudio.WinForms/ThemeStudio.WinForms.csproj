<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows-only head of the Theme Studio: the same CSS editor and diagnostics as
       samples/ThemeStudio, with a REAL System.Windows.Forms preview (one of each mapped control)
       applied through Majorsilence.Forms.Theming.WinForms. The Avalonia-hosted Studio cannot show
       WinForms controls, and WinForms only builds and runs on Windows — off Windows this compiles to
       an empty placeholder so the full-solution build stays green on the Linux/macOS CI legs. -->

  <PropertyGroup>
    <_IsWindowsBuild Condition="'$(OS)' == 'Windows_NT'">true</_IsWindowsBuild>
    <RootNamespace>ThemeStudio.WinForms</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(_TargetFramework)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWindowsBuild)' != 'true'">
    <TargetFramework>$(_TargetFramework)</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Theming.WinForms\Majorsilence.Forms.Theming.WinForms.csproj" />
  </ItemGroup>

  <!-- The same example themes as the Avalonia head, so one file can be opened in both. -->
  <ItemGroup Condition="'$(_IsWindowsBuild)' == 'true'">
    <None Include="..\ThemeStudio\Themes\*.css" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
