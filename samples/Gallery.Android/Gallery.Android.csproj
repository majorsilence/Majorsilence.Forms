<Project Sdk="Microsoft.NET.Sdk">

  <!-- Android head for the control gallery, hosted by Avalonia.

       This IS a member of Majorsilence.Forms.slnx, but only builds as a real Android app when the
       `android` workload is installed. A net10.0-android TFM needs that workload's reference assemblies
       just to compile (unlike wasm-tools, which is only needed to publish), so unconditionally targeting
       it would break CI's default `dotnet build` matrix and every contributor who hasn't installed the
       workload.

       The repo-root Directory.Build.props resolves EnableAndroidHead: on when the workload's SDK pack
       is on disk (Visual Studio's ".NET Multi-platform App UI development" install does this; so does
       CI's dedicated android job) and the EnableMobileHeads umbrella is on, or forced outright with
       -p:EnableAndroidTarget=true. When it is off, this compiles in about a second as an empty net10.0
       library, with none of the Android sources or packages below, so solution-wide builds keep working
       everywhere. Force it with `-p:EnableMobileHeads=true`.

       Keyed on EnableAndroidHead rather than EnableMobileHeads because the umbrella covers ios too, and
       the two need different workloads. See Directory.Build.props.

       Build/run on a device or emulator (workload installed): `dotnet build -t:Run` from this directory. -->

  <PropertyGroup>
    <TargetFramework Condition="'$(EnableAndroidHead)' == 'true'">net10.0-android</TargetFramework>
    <TargetFramework Condition="'$(EnableAndroidHead)' != 'true'">net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Real Android app: workload present. -->
  <PropertyGroup Condition="'$(EnableAndroidHead)' == 'true'">
    <OutputType>Exe</OutputType>
    <ApplicationId>com.majorsilence.gallery</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableAndroidHead)' == 'true'">
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <!-- EnableAndroidHead (a repo-wide property) also opts Majorsilence.Forms.Avalonia's net10.0-android
         TFM row in, so this reference resolves to it; see that csproj's TargetFrameworks comment. -->
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Avalonia\Majorsilence.Forms.Avalonia.csproj" />
    <!-- Reuse the full ControlGallery MainForm/panels to render the whole gallery on Avalonia-on-Android. -->
    <ProjectReference Include="..\ControlGallery\ControlGallery.csproj" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableAndroidHead)' == 'true'">
    <!-- ImageLoader.cs (backend-agnostic, plain File.Open under a relative "Images" folder) has no
         concept of APK assets, so these are bundled as Android assets and extracted to app-private
         storage at startup instead; see GalleryApplication.ExtractImageAssets in App.cs. -->
    <AndroidAsset Include="..\ControlGallery\Images\**\*.png" Link="Images\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Stub build: no workload. An empty library, referenced by nothing. -->
  <PropertyGroup Condition="'$(EnableAndroidHead)' != 'true'">
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableAndroidHead)' != 'true'">
    <!-- These use Android.* / Avalonia.Android, which do not exist without the workload. -->
    <Compile Remove="MainActivity.cs" />
    <Compile Remove="App.cs" />
  </ItemGroup>

</Project>
