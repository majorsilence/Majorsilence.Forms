<Project Sdk="Microsoft.NET.Sdk">

  <!-- Demo/validation sample for the Majorsilence.Forms.WinFormsShims.Compat generated System.Windows.Forms build of Majorsilence.Forms: an
       unmodified `using System.Windows.Forms;` WinForms-style Form1.cs/Form1.Designer.cs pair plus
       a Program.cs that calls Application.Run/MessageBox.Show, checking how much of it compiles,
       and, with the Avalonia backend referenced below, actually runs, against Majorsilence.Forms
       + the generated compat namespace, with zero source changes. See RESULTS.md and the feasibility
       plan this exists to validate. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not Majorsilence.Forms / Majorsilence.Forms.Avalonia: the generated System.Windows.Forms builds of
         them replace those, so the unmodified `using System.Windows.Forms;` source below binds to these. -->
    <ProjectReference Include="..\..\src\Majorsilence.Forms.WinFormsShims.Compat\Majorsilence.Forms.WinFormsShims.Compat.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms.WinFormsShims.Compat.Avalonia\Majorsilence.Forms.WinFormsShims.Compat.Avalonia.csproj" />
  </ItemGroup>

</Project>
