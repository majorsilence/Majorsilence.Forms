<Project Sdk="Microsoft.NET.Sdk">

  <!-- iOS head for the control gallery, hosted by Avalonia.

       This IS a member of Majorsilence.Forms.slnx, but only builds as a real iOS app on macOS with the
       `ios` workload installed. A net10.0-ios TFM needs that workload's reference assemblies just to
       compile, and Apple's toolchain (a hard requirement for the workload) only exists on macOS.

       The repo-root Directory.Build.props sets EnableMobileHeads=true when it detects a mobile workload;
       this project additionally requires the host OS to be macOS (_IOSHeadEnabled below). Everywhere
       else, including CI's default `dotnet build` matrix and Windows/Linux contributors, this compiles
       as an empty net10.0 library so solution-wide builds keep working. CI's dedicated ios job
       (macos-latest) sets -p:EnableMobileHeads=true for the real build.

       IMPORTANT: unlike every other sample in this repo, none of this project's real source files (Main.cs,
       AppDelegate.cs, Info.plist) have been compiled or run, since there is no macOS/Xcode host available
       to do that with. Everything there is written from Avalonia.iOS's actual decompiled API
       (Avalonia.iOS.AvaloniaAppDelegate, IOSApplicationExtensions.UseiOS, SingleViewLifetime) and from
       standard .NET-for-iOS project conventions, but treat it as a first draft to be fixed up once it is
       actually built on a Mac or in CI, not as verified working code.

       Build/run on a simulator or device (from a Mac, with the ios workload installed):
       `dotnet build -t:Run` from this directory. -->

  <PropertyGroup>
    <_IOSHeadEnabled Condition="'$(EnableMobileHeads)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">true</_IOSHeadEnabled>

    <TargetFramework Condition="'$(_IOSHeadEnabled)' == 'true'">net10.0-ios</TargetFramework>
    <TargetFramework Condition="'$(_IOSHeadEnabled)' != 'true'">net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Real iOS app: macOS plus the ios workload. -->
  <PropertyGroup Condition="'$(_IOSHeadEnabled)' == 'true'">
    <OutputType>Exe</OutputType>
    <ApplicationId>com.majorsilence.gallery</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Matches Avalonia.iOS's own minimum (its AvaloniaAppDelegate/AvaloniaSceneDelegate code is
         gated behind [SupportedOSPlatform("ios13.0")] in several places). -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IOSHeadEnabled)' == 'true'">
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <!-- EnableMobileHeads (a repo-wide property) on macOS also opts Majorsilence.Forms.Avalonia's
         net10.0-ios TFM row in, so this reference resolves to it; see that csproj's TargetFrameworks
         comment. -->
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Avalonia\Majorsilence.Forms.Avalonia.csproj" />
    <!-- Reuse the full ControlGallery MainForm/panels to render the whole gallery on Avalonia-on-iOS. -->
    <ProjectReference Include="..\ControlGallery\ControlGallery.csproj" />
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!-- .NET for iOS runs ILLink ("Optimizing assemblies for size") during a plain Release `dotnet build`,
       which desktop/Android skip, so this is the only project in the repo that sees trim analysis at all.
       Avalonia.DesignerSupport (design time only, pulled in transitively by Avalonia, no role at app
       runtime) is not annotated as trim safe and so produces IL2104.

       IL2104 is a warning, but this repo's Directory.Build.props turns on TreatWarningsAsErrors for
       Release, and Microsoft.NET.ILLink.targets defaults ILLinkTreatWarningsAsErrors to that same value,
       which is what promoted it to an error and failed the build with NETSDK1144.

       Opt just the trimmer out of that policy. The repo's warnings as errors rule still applies in full to
       this project's own C# code; IL2104 stays visible in the build log, it simply is not fatal. Preferred
       over NoWarn on the one code, since any other package assembly producing trim warnings under a
       different IL2xxx code would otherwise fail CI the same way. Note the SDK itself defaults
       SuppressTrimAnalysisWarnings to true for UseWpf/UseWindowsForms projects, i.e. it already treats
       trim analysis as non actionable noise for desktop UI frameworks, which is exactly this case.
       See https://aka.ms/il2104. -->
  <PropertyGroup Condition="'$(_IOSHeadEnabled)' == 'true'">
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IOSHeadEnabled)' == 'true'">
    <!-- ImageLoader.cs (backend-agnostic, plain File.Open under a relative "Images" folder) just needs
         the process's current directory to be the folder containing "Images" at runtime. Unlike
         Android's APK assets, BundleResource items land directly on the filesystem inside the app
         bundle's Resources, so (unlike Gallery.Android) no runtime extraction step is needed, just
         pointing the cwd there; see AppDelegate.cs. -->
    <BundleResource Include="..\ControlGallery\Images\**\*.png" LogicalName="Images\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Stub build: not macOS, or no workload. An empty library, referenced by nothing. -->
  <PropertyGroup Condition="'$(_IOSHeadEnabled)' != 'true'">
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IOSHeadEnabled)' != 'true'">
    <!-- These use ObjCRuntime / UIKit / Avalonia.iOS, which do not exist without the workload. -->
    <Compile Remove="Main.cs" />
    <Compile Remove="AppDelegate.cs" />
  </ItemGroup>

</Project>
