<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Standalone head: manage its own (nuget.org-only) versions, independent of the repo CPM. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Gtk4\Majorsilence.Forms.Gtk4.csproj" />
    <!-- Reuse the full ControlGallery MainForm to render the whole gallery on GTK 4. ControlGallery is
         a backend-agnostic library. -->
    <ProjectReference Include="..\ControlGallery\ControlGallery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gallery loads PNGs from an "Images" folder relative to the working dir. -->
    <Content Include="..\ControlGallery\Images\**\*.png" Link="Images\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
  </ItemGroup>

</Project>
