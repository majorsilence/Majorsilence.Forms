<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Backend-agnostic library: the shared MainForm/panels, consumed by the Gallery.Avalonia and
         Gallery.Uno app heads. It has no OutputType (defaults to Library) and no backend
         ProjectReference — each head brings its own backend and picks its own default (Uno for
         Gallery.Uno, Avalonia for Gallery.Avalonia) instead of ControlGallery dragging one in for
         every consumer. -->
    <TargetFramework>$(_TargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Forms\Majorsilence.Forms.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Forms.Telerik\Majorsilence.Forms.Telerik.csproj" />
  </ItemGroup>

  <ItemGroup>
