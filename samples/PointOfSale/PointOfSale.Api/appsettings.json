{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=pos.db"
  },
  "Tax": {
    "Rate": 0.08
  },
  "Jwt": {
    "SigningKey": "REPLACE_IN_appsettings.Development.json_OR_ENVIRONMENT-this-default-is-not-a-secret",
    "Issuer": "PointOfSale.Api",
    "Audience": "PointOfSale.Client",
    "TokenLifetimeMinutes": 480,
    "OverrideTokenLifetimeMinutes": 2
  }
}
