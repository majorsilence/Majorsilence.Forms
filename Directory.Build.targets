<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Runtime async for .NET 11 and later: the compiler emits async methods as runtime-async IL instead
    of generating a state machine, and the runtime does the suspension itself. That means fewer
    allocations per await and shorter stack traces. It changes only this assembly's IL, never its
    public API. Callers still get ordinary Task / ValueTask values, so a net11.0 consumer can mix
    these assemblies with state-machine ones.

    It lives here and not in Directory.Build.props because a single-TFM project sets
    $(TargetFramework) in its own body, after the props are imported. By the time these targets are
    imported every project has one. The net8.0 / net10.0 / netstandard2.0 rows keep the state-machine
    form, since their runtimes cannot run the new IL.

    It is still a preview feature in .NET 11; see
    https://learn.microsoft.com/dotnet/core/whats-new/dotnet-11/runtime. A project opts out with
    <UseRuntimeAsync>false</UseRuntimeAsync>, the same property the SDK uses for this.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' and '$(UseRuntimeAsync)' != 'false' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
</Project>
