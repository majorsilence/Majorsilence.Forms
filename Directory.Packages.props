<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Official Avalonia webview control (native engines: WebView2/WKWebView/WebKitGTK-WPE — no Chromium
         bundle). Referenced only by Majorsilence.Forms.Avalonia; core/Headless/Uno take no dependency. -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <!-- Avalonia's WebAssembly/browser platform. Only referenced by Majorsilence.Forms.Avalonia's
         net10.0-browser TFM row (desktop TFMs use Avalonia.Desktop instead) and by samples/Gallery.Wasm. -->
    <PackageVersion Include="Avalonia.Browser" Version="12.1.1" />
    <!-- Avalonia's Android platform. Only referenced by Majorsilence.Forms.Avalonia's opt-in
         net10.0-android TFM row (see EnableAndroidHead in Directory.Build.props) and by samples/Gallery.Android. -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.1" />
    <!-- Avalonia's iOS platform. Only referenced by Majorsilence.Forms.Avalonia's opt-in
         net10.0-ios TFM row (see EnableIOSHead in Directory.Build.props) and by samples/Gallery.iOS. Unlike
         the android workload, the ios workload only installs (and this can only build) on macOS,
         verified in CI's dedicated ios job (macos-latest), not on the main build job's runners. -->
    <PackageVersion Include="Avalonia.iOS" Version="12.1.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Span<T>/ReadOnlySpan<T> polyfill for Majorsilence.Forms.Drawing.Common's netstandard2.0 row. -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <!-- Source-generated polyfills (System.Index/Range, CallerArgumentExpressionAttribute, the
         trimming attributes, ...) for Majorsilence.Forms.Drawing.Common's netstandard2.0 row. -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <!-- Force SkiaSharp.HarfBuzz + HarfBuzzSharp up to match SkiaSharp 3.119.4. RichTextKit 0.4.167
         transitively pins these to 2.88.7 / 2.8.2.3, which mismatches the SkiaSharp 3.x native libs
         (a latent crash, notably the HarfBuzzSharp.NativeAssets.Linux 2.8 vs managed 7.3 mismatch). -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.7" />
    <!-- Safe reader for the legacy BinaryFormatter wire format (NRBF) — used to recover images from
         WinForms .resx binary.base64 resources without running BinaryFormatter. -->
    <PackageVersion Include="System.Formats.Nrbf" Version="9.0.0" />
    <!-- In the .NET shared framework on net8.0/net10.0; needed only for Majorsilence.Forms' and
         Majorsilence.Forms.Telerik's netstandard2.0 rows (a couple of JsonSerializer.Serialize
         drag-and-drop call sites). Kept on the 9.0.x line to match System.Formats.Nrbf above. -->
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <!-- ValueTask / ValueTask<T> for the netstandard2.0 row (public InvokeAsync overloads mirror
         WinForms .NET 9). In-box on the .NET TFMs. -->
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <!-- System.Reflection.Metadata.TypeName appears in ITypedDataObject.TryGetData's public signature;
         in-box on net8.0/net10.0, a package for the netstandard2.0 row. Matches System.Formats.Nrbf's
         own dependency. -->
    <PackageVersion Include="System.Reflection.Metadata" Version="9.0.0" />
    <!-- Reads the standard SDK-compiled .resources binary format that ported WinForms projects
         embed (ComponentResourceManager.ApplyResources' real data source; see that class). The
         plain BCL System.Resources.ResourceReader can't read it when the project sets
         GenerateResourceUsePreserializedResources=true (which every migrated .Forms project does,
         to avoid BinaryFormatter); only this package's DeserializingResourceReader can. -->
    <PackageVersion Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <!-- .NET Framework reference assemblies so the net472 consumer smoke test
         (tests/Majorsilence.Forms.NetFxSmoke) builds on Linux/macOS CI runners too. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.201" />
    <!-- samples/ControlGallery's CommunityToolkit.Mvvm panel: source-generated ObservableObject/
         RelayCommand. Majorsilence.Forms.Control.DataBindings is a stub (see WinFormsCompat.cs), so the
         panel wires the ViewModel's PropertyChanged/ICommand manually rather than declaratively. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Compiler-integrated Roslyn source generator API (IIncrementalGenerator), used by the
         Majorsilence.Forms.WinFormsShims.Compat PoC generator. Pinned well below the Workspaces
         packages' 5.6.0 (which tracks this repo's own net10.0 SDK) deliberately: a generator loads
         into whatever Roslyn version the *consumer's* SDK/IDE ships, and referencing a newer
         compiler API than the host has makes the host refuse to load the analyzer outright
         (CS9057); confirmed hitting exactly that against this repo's own installed SDK before
         this was pinned down. 4.11.0 is a broadly-supported floor for current SDKs/VS versions. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!-- Optional Roslyn source-rewrite engine for the migrator (majorsilence-migrate's "engine roslyn"
         flag). Kept at matching versions across the three Microsoft.CodeAnalysis.* packages, per
         Roslyn's own versioning convention. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Microsoft.Build.Locator's build-time check (MSBL001) requires an explicit, excluded reference to
         the MSBuild assemblies it will instead resolve at runtime from the located SDK — otherwise the
         transitive reference pulled in by Microsoft.CodeAnalysis.Workspaces.MSBuild risks a runtime
         assembly-loading conflict. Version pinned only to satisfy restore; ExcludeAssets/PrivateAssets
         below mean it never actually ships or loads from this reference. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Topten.RichTextKit" Version="0.4.167" />
    <!-- Uno backend (restored from nuget.org via src/Majorsilence.Forms.Uno/nuget.config). -->
    <PackageVersion Include="Uno.WinUI" Version="6.5.237" />
    <PackageVersion Include="Uno.WinUI.Runtime.Skia.X11" Version="6.5.237" />
    <PackageVersion Include="Uno.WinUI.Runtime.Skia.Win32" Version="6.5.237" />
    <PackageVersion Include="Uno.WinUI.Runtime.Skia.MacOS" Version="6.5.237" />
    <PackageVersion Include="SkiaSharp.Views.Uno.WinUI" Version="3.119.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- samples/PointOfSale: first EF Core / ASP.NET Core backend sample in the repo. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- EF Core Sqlite transitively pins SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q). Bump the whole SQLitePCLRaw family to the
         patched 3.0.5 line explicitly since CentralPackageTransitivePinningEnabled is false here. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- tools/Majorsilence.Forms.Mcp: the official MCP C# SDK, which supplies the stdio JSON-RPC
         transport and the tool discovery/schema generation, plus the generic host it plugs into. The
         MCP server is a standalone client of the app's WebDriver endpoint, so neither package is
         referenced by anything the framework itself ships. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- tools/Majorsilence.Forms.ApiDiff: reflection-only loads of System.Drawing.Common and
         System.Windows.Forms for the API gap audit. The WindowsDesktop targeting pack is never
         referenced for compilation, only opened as metadata, so its Windows-only runtime is irrelevant. -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
    <PackageVersion Include="Microsoft.WindowsDesktop.App.Ref" Version="10.0.10" />
    <!-- benchmarks/Majorsilence.Forms.Benchmarks: micro-benchmarks for the Drawing/layout/paint
         hotspots found while stress-testing the control gallery. Not shipped in any package. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>