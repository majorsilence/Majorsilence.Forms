<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- .NET version to build for -->
    <_TargetFramework>net10.0</_TargetFramework>
     <Version>26.0.51</Version>
    
    <!-- NuGet packaging info. Authors is set explicitly (it otherwise defaults to each project's
         assembly name) so every package under the Majorsilence.* id prefix reports the same author as
         the nuget.org account that owns it, one of the things nuget.org checks when reviewing an id
         prefix reservation. PackageLicenseExpression is the current element; licenseUrl is deprecated
         and must not be used. -->
    <Authors>Majorsilence</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The documentation site, not the repo: nuget.org renders PackageProjectUrl as "Project
         website" and separately renders the SourceLink-provided RepositoryUrl as the source
         repository, so pointing this at GitHub duplicated one link and wasted the other. -->
    <PackageProjectUrl>https://forms.majorsilence.com</PackageProjectUrl>

    <!-- SourceLink info -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    
    <!-- Include symbol files (*.pdb) in the built .nupkg -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <!-- Default to using NRT annotations and implicit usings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat warnings as errors in Release builds (this keeps them from getting in the way
         while developing locally, but ensures CI doesn't allow warnings to be committed). -->
    <TreatWarningsAsErrors Condition=" '$(Configuration)' == 'Release' ">true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    
    <!-- NU5104: A stable release of a package should not have a prerelease dependency. -->
    <!-- CA1711/CA1716: this is a WinForms/Telerik/System.Drawing compatibility layer, so public
         API names (e.g. StringFormatFlags, GridViewCellCollection, a Stop() method) intentionally
         mirror the originals and cannot be renamed to satisfy these naming-convention analyzers. -->
    <!-- NU1507: fires when the machine has multiple NuGet sources configured under central package
         management. The source list is environment-specific (enterprise feeds), not something the
         repo controls, so it shouldn't fail a Release build under TreatWarningsAsErrors. -->
    <NoWarn>$(NoWarn);NU5104;CA1711;CA1716;NU1507</NoWarn>
  </PropertyGroup>

  <!-- Required for Deterministic -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    EnableMobileHeads gates the platform-specific gallery heads (samples/Gallery.Android,
    samples/Gallery.iOS) and Majorsilence.Forms.Avalonia's matching net10.0-android and net10.0-ios TFM
    rows. Those are members of Majorsilence.Forms.slnx, but a net10.0-android or net10.0-ios TFM needs
    its workload's reference assemblies even to compile (unlike wasm-tools, which is only needed to
    publish), so they can only build where the workload is installed.

    Default: auto-on when the `android` workload's SDK pack is on disk (Visual Studio's ".NET
    Multi-platform App UI development" install puts it there; so does CI's dedicated mobile job). Off
    otherwise, so CI's plain `dotnet build` matrix and contributors without the workload still build the
    whole solution, with the heads compiling as tiny empty net10.0 stub libraries and the Avalonia
    mobile rows dropping out. Override with `-p:EnableMobileHeads=true` or `-p:EnableMobileHeads=false`.

    $(NetCoreRoot) is not populated this early in evaluation, but $(MSBuildToolsPath)
    (the dotnet/sdk/<version> folder) is; its grandparent is the dotnet root that holds packs/.
  -->
  <PropertyGroup>
    <_DotNetRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/../..'))</_DotNetRoot>
    <_AndroidWorkloadInstalled Condition="
        Exists('$(_DotNetRoot)/packs/Microsoft.Android.Sdk.Windows') or
        Exists('$(_DotNetRoot)/packs/Microsoft.Android.Sdk.Darwin') or
        Exists('$(_DotNetRoot)/packs/Microsoft.Android.Sdk.Linux')">true</_AndroidWorkloadInstalled>

    <EnableMobileHeads Condition="'$(EnableMobileHeads)' == '' and '$(_AndroidWorkloadInstalled)' == 'true'">true</EnableMobileHeads>
    <EnableMobileHeads Condition="'$(EnableMobileHeads)' == ''">false</EnableMobileHeads>
  </PropertyGroup>
</Project>
